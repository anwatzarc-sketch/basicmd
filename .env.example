# =====================================================================
#  MEDICAREMINI - ENVIRONMENT CONFIGURATION
#  Copy to `.env` and fill in. NEVER commit the real .env file.
#
#      cp .env.example .env
#      php bin/install.php
# =====================================================================

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_NAME="MediCareMini"
APP_ENV=production                  # local | staging | production
APP_DEBUG=false                     # MUST be false in production - controls stack-trace display
APP_URL=http://medicaremini.radiants.net.et
APP_TIMEZONE=Africa/Addis_Ababa
APP_LOCALE=en                       # en | am
APP_ADMIN_PATH=admin                # change to obscure the portal path, e.g. "staff-portal"

# 32+ random bytes, base64. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# ---------------------------------------------------------------------
# Database (MariaDB 10.4+)
# ---------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=MediCareMini
DB_USERNAME=medicaremini_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
# Leave empty unless your host requires TLS to MySQL
DB_SSL_CA=

# ---------------------------------------------------------------------
# Session & security
# ---------------------------------------------------------------------
SESSION_NAME=medicaremini_session
SESSION_LIFETIME_MIN=45             # idle timeout; user is logged out after this
SESSION_ABSOLUTE_HOURS=8            # hard cap regardless of activity
SESSION_SAME_SITE=Lax

# Marks the session cookie "Secure", so the browser only sends it over HTTPS.
#
# This MUST match the scheme in APP_URL. With APP_URL=http:// and this left
# true, a browser accepts the cookie at login but never sends it back - sign-in
# appears to succeed, then every following request is anonymous and bounces
# straight back to the login page. It looks like broken auth; it is this flag.
#
# Set true the moment TLS is in front of the site, and leave it true.
SESSION_SECURE=false

# Argon2id tuning. Raise memory_cost on a well-resourced VPS.
ARGON_MEMORY_COST=65536             # KiB (64 MB)
ARGON_TIME_COST=4
ARGON_THREADS=2

# Account lockout after repeated failed logins
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Public form throttling (fixed window)
RATE_BOOKING_PER_HOUR=5
RATE_CONTACT_PER_HOUR=5
RATE_PROOF_PER_HOUR=10

# Comma-separated hosts allowed to serve the app. Blocks Host-header attacks.
#
# MUST list the host the browser actually sends, or EVERY request is answered
# with "400 Invalid host" and the site is completely unreachable. Host only -
# no scheme, no port, no path. Add each hostname that should serve the site.
TRUSTED_HOSTS=medicaremini.radiants.net.et
# Set to 1 only when behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# ---------------------------------------------------------------------
# Mail - PHPMailer over SMTP
#
# LOCAL DEVELOPMENT: point at a catch-all SMTP sink so no real mail
# escapes. MailHog (localhost:1025) or Papercut both work with:
#   MAIL_HOST=127.0.0.1  MAIL_PORT=1025  MAIL_ENCRYPTION=  MAIL_AUTH=false
#
# MAIL_MAILER=log writes rendered messages to storage/logs/mail.log
# instead of sending - useful before SMTP credentials exist.
# ---------------------------------------------------------------------
MAIL_MAILER=smtp                    # smtp | log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=                    # tls | ssl | (empty for local sink)
MAIL_AUTH=false                     # true once real credentials are set
# The From domain must be one your SMTP server is authorised to send for
# (SPF / DKIM). Sending as a domain that does not authorise the relay is the
# fastest way into a patient's spam folder - and booking confirmations landing
# in spam look exactly like a broken booking system.
MAIL_FROM_ADDRESS=no-reply@medicaremini.radiants.net.et
MAIL_FROM_NAME="MediCareMini"
MAIL_REPLY_TO=info@medicaremini.radiants.net.et
# Internal inbox that receives new-booking / new-proof / new-inquiry alerts.
# These must be mailboxes someone actually reads: a payment receipt sitting
# unverified blocks the patient's appointment.
MAIL_ADMIN_INBOX=frontdesk@medicaremini.radiants.net.et
MAIL_FINANCE_INBOX=finance@medicaremini.radiants.net.et
# Rewrites every recipient to this address (staging safety net). Leave empty in production.
MAIL_CATCH_ALL=

# Queue worker
QUEUE_BATCH_SIZE=25
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_BACKOFF_MIN=5           # attempt N waits N * this many minutes

# ---------------------------------------------------------------------
# Booking rules
# ---------------------------------------------------------------------
BOOKING_LEAD_HOURS=12               # earliest bookable slot, from now
BOOKING_HORIZON_DAYS=60             # furthest bookable date
EXPRESS_SURCHARGE_RATE=0.20         # VIP / express queue: +20%
REMINDER_LEAD_HOURS=24
FOLLOWUP_DELAY_HOURS=48

# ---------------------------------------------------------------------
# Uploads
#
# Payment proofs contain financial data and are stored OUTSIDE the
# webroot. They are streamed only through an authenticated controller.
# ---------------------------------------------------------------------
UPLOAD_PROOF_DIR=storage/uploads/proofs
UPLOAD_MEDIA_DIR=storage/uploads/media
UPLOAD_PROOF_MAX_MB=5
UPLOAD_MEDIA_MAX_MB=8
UPLOAD_WEBP_QUALITY=82

# ---------------------------------------------------------------------
# Maps (public site location hub)
# Leave GOOGLE_MAPS_API_KEY empty to fall back to an OpenStreetMap
# iframe, which needs no key and no billing account.
# ---------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
MAP_LATITUDE=8.9969
MAP_LONGITUDE=38.7869
MAP_ZOOM=16

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=warning                   # debug | info | notice | warning | error | critical
LOG_MAX_FILES=30                    # daily rotation retention

# ---------------------------------------------------------------------
# Frontend assets
# DEV: set false to load Tailwind from CDN so you can edit without
# running `npm run build`. MUST be true in production.
# ---------------------------------------------------------------------
ASSETS_BUILT=true

# ---------------------------------------------------------------------------
# Site assistant (AI chat widget)
# ---------------------------------------------------------------------------
# Off by default. The widget only renders when AI_ENABLED=true AND a model is
# configured, so leaving this alone changes nothing about the site.
#
# Written against the OpenAI-compatible /chat/completions shape, which most
# hosted models speak. Switching provider is these four lines, not code:
#
#   Groq (free tier, fast)   https://api.groq.com/openai/v1
#                            AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter (free tier)   https://openrouter.ai/api/v1
#                            AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Google Gemini (compat)   https://generativelanguage.googleapis.com/v1beta/openai
#                            AI_MODEL=gemini-2.0-flash
#   Local Ollama             http://127.0.0.1:11434/v1
#                            AI_MODEL=llama3.1   (AI_API_KEY may be left blank)
#
# PRIVACY: visitor messages leave your server and reach the provider above.
# The assistant is instructed not to collect health details and has no access
# to appointments, payments or patient records - but choose a provider whose
# terms you are willing to stand behind, and tell patients in your privacy
# policy. A local Ollama keeps everything in-house if that matters to you.
AI_ENABLED=false
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT=20

RATE_CHAT_PER_HOUR=40
